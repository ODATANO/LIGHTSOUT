{
  "name": "lightsout-board",
  "version": "0.1.0",
  "private": true,
  "description": "A board on Midnight where members of the bridge put rewards in wrapped NEAR on answers of a NEAR AI model, which the contract checks",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./managed/board/contract/index.d.ts",
      "default": "./managed/board/contract/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "compact compile +0.36.0 src/board.compact managed/board",
    "test": "tsx --test --test-force-exit test/*.test.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/zkir-v3": "3.2.1",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@noble/curves": "^2.4.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
