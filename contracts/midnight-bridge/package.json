{
  "name": "lightsout-midnight-bridge",
  "version": "0.1.0",
  "description": "Wrapped NEAR on Midnight, minted for any lock that a NEAR light client inside the contract proved",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODATANO/LIGHTSOUT.git",
    "directory": "contracts/midnight-bridge"
  },
  "homepage": "https://github.com/ODATANO/LIGHTSOUT#readme",
  "keywords": [
    "midnight",
    "compact",
    "near",
    "bridge",
    "zero-knowledge"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./managed/midnight-bridge/contract/index.d.ts",
      "default": "./managed/midnight-bridge/contract/index.js"
    },
    "./contract.json": "./contract.json",
    "./package.json": "./package.json"
  },
  "files": [
    "contract.json",
    "src/*.compact",
    "managed/**/*",
    "!managed/**/*.prover",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "compact compile +0.36.0 src/midnight-bridge.compact managed/midnight-bridge",
    "test": "tsx --test --test-force-exit test/*.test.mjs",
    "prove": "tsx scripts/prove.mjs",
    "prepublishOnly": "npm --prefix ../../kit run contract-package -- --check"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0"
  },
  "devDependencies": {
    "@midnight-ntwrk/zkir-v3": "3.2.1",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@noble/curves": "^2.4.0",
    "@scure/base": "2.4.0",
    "tsx": "^4.23.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
