{
  "name": "lightsout-mcp",
  "version": "0.1.2",
  "private": true,
  "description": "MCP server for one LIGHTSOUT agent: deposit NEAR, send wNEAR, withdraw to NEAR, ask a model for a reward, answer bounties",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODATANO/LIGHTSOUT.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/ODATANO/LIGHTSOUT#readme",
  "keywords": [
    "mcp",
    "near",
    "midnight",
    "bridge",
    "agents"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --env-file=../.env src/server.ts",
    "crowd": "tsx --env-file=../.env src/crowd.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/crowd/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "lightsout-kit": "0.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
