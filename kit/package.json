{
  "name": "lightsout-kit",
  "version": "0.1.0",
  "private": true,
  "description": "For agents with a NEAR account: the bridge, its relay, and rewards for NEAR AI answers that a contract checks",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ODATANO/LIGHTSOUT.git",
    "directory": "kit"
  },
  "homepage": "https://github.com/ODATANO/LIGHTSOUT#readme",
  "keywords": [
    "near",
    "midnight",
    "bridge",
    "agents",
    "zero-knowledge"
  ],
  "type": "module",
  "exports": {
    "./agent": "./src/agent.ts",
    "./overview": "./src/overview.ts",
    "./roles": "./src/roles.ts",
    "./bridge": "./src/bridge.ts",
    "./near": "./src/near.ts",
    "./codec": "./src/codec.ts",
    "./question": "./src/board/question.ts",
    "./shown": "./src/shown.ts",
    "./deposit": "./src/deposit.ts",
    "./join": "./src/join.ts",
    "./history": "./src/history.ts",
    "./env": "./src/env.ts",
    "./keep": "./src/keep.ts",
    "./log": "./src/log.ts",
    "./plain-errors": "./src/plain-errors.ts",
    "./reason": "./src/reason.ts",
    "./websocket": "./src/websocket.ts",
    "./crowd/counts": "./src/crowd/counts.ts",
    "./crowd/limits": "./src/crowd/limits.ts",
    "./crowd/mind": "./src/crowd/mind.ts",
    "./live": "./src/live.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agent": "tsx --env-file=../.env src/cli.ts",
    "relay": "tsx --env-file=../.env src/ops/relay.ts",
    "solve": "tsx --env-file=../.env src/ops/solve.ts",
    "warm": "tsx --env-file=../.env src/ops/warm.ts",
    "make-agent": "tsx --env-file=../.env src/ops/make-agent.ts",
    "status": "tsx --env-file=../.env src/status.ts",
    "deploy": "tsx --env-file=../.env src/ops/deploy.ts",
    "mint": "tsx --env-file=../.env src/ops/mint.ts",
    "table": "tsx --env-file=../.env src/ops/table.ts",
    "sponsor": "tsx --env-file=../.env src/ops/sponsor.ts",
    "release": "tsx --env-file=../.env src/ops/release.ts",
    "mithril": "tsx --env-file=../.env src/ops/mithril-sync.ts",
    "make-init": "tsx --env-file=../.env src/ops/make-init.ts",
    "deploy-board": "tsx --env-file=../.env src/ops/deploy-board.ts",
    "demo": "tsx --env-file=../.env src/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/board/*.test.ts src/crowd/*.test.ts src/inference/*.test.ts",
    "packages": "tsx scripts/npm-packages.ts",
    "contract-package": "tsx scripts/contract-package.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.0",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0",
    "@midnightntwrk/wallet-sdk-dust-wallet": "5.0.0",
    "@midnightntwrk/wallet-sdk-facade": "5.0.0",
    "@midnightntwrk/wallet-sdk-hd": "4.0.0",
    "@midnightntwrk/wallet-sdk-shielded": "4.0.0",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.0",
    "@noble/curves": "^2.4.0",
    "@odatano/contract-kit": "0.2.1",
    "@odatano/nightgate-tx": "0.22.0",
    "@phala/dcap-qvl": "0.7.1",
    "@polkadot/types": "16.5.6",
    "@polkadot/types-codec": "16.5.6",
    "@polkadot/util": "14.0.3",
    "@scure/base": "2.4.0",
    "lightsout-board": "0.1.0",
    "lightsout-burn-proof": "0.1.0",
    "lightsout-midnight-bridge": "0.1.0",
    "near-api-js": "7.4.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
