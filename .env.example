# NEAR
# The live deployment's contract.
NEAR_BRIDGE_CONTRACT=oda_bridge.odatano.testnet
NEAR_OWNER_ACCOUNT_ID=lightsout.odatano.testnet
NEAR_OWNER_PRIVATE_KEY=ed25519:...
NEAR_ALICE_ACCOUNT_ID=alice.lightsout.odatano.testnet
NEAR_ALICE_PRIVATE_KEY=ed25519:...
NEAR_BOB_ACCOUNT_ID=bob.lightsout.odatano.testnet
NEAR_BOB_PRIVATE_KEY=ed25519:...
# Any NEAR account with gas. `npm run relay` and `npm run release` pay their NEAR calls from it.
NEAR_RELAYER_ACCOUNT_ID=relayer.lightsout.odatano.testnet
NEAR_RELAYER_PRIVATE_KEY=ed25519:...
# Optional: a NEAR RPC with a higher rate limit than the public one.
# NEAR_RPC_URL=
# Only for answering bounties (`npm run solve`). Posting a bounty and reading its answer need no
# NEAR AI account.
NEARAI_CLOUD_API_KEY=sk-...
# Optional: another NEAR AI Cloud endpoint, by default https://cloud-api.near.ai.
# NEARAI_CLOUD_BASE_URL=

# Midnight network
MIDNIGHT_NETWORK=preview
MIDNIGHT_NODE_URL=https://rpc.preview.midnight.network
# Optional: the least time in ms between two requests to that node, default 250. 0 turns it off for your own node.
# MIDNIGHT_NODE_MIN_INTERVAL_MS=
MIDNIGHT_INDEXER_HTTP_URL=https://indexer.preview.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
# Proves in about a minute per call and sees the coins of the wallet it proves for, so run it locally:
# docker run -d -p 127.0.0.1:6300:6300 midnightntwrk/proof-server:9.0.0
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# The live deployment on preview. Your own come from `npm run deploy` and `npm run deploy-board` in kit/.
MIDNIGHT_BRIDGE=5c39479a5666072e78c7af78a15156ccf9584302a863a6a512e72a29294084ee
MIDNIGHT_BOARD=43ec11c09a17c848e751e6bd3a4347d4378610ac6ff1dbcdfbe270e38e98f44f

# Midnight wallets
# Without a gateway this wallet pays bridge calls and transfers. It registers its own NIGHT for dust.
# Board calls are paid from the calling agent's own dust.
MIDNIGHT_FEE_SEED_HEX=<128 hex, node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
# `npm run sponsor` sets NIGHT of this wallet aside for each registered account, so that it
# generates dust for that account. The wallet pays its own fees and needs NIGHT, nothing else.
MIDNIGHT_SPONSOR_SEED_HEX=
# The Midnight wallets of the two agents.
MIDNIGHT_ALICE_SEED_HEX=<128 hex, same as above>
MIDNIGHT_BOB_SEED_HEX=<128 hex, same as above>
# One more agent is the same three variables under its name: NEAR_<NAME>_ACCOUNT_ID,
# NEAR_<NAME>_PRIVATE_KEY and MIDNIGHT_<NAME>_SEED_HEX. `npm run make-agent -- <name>` writes them.

# Gateway
# A NIGHTGATE gateway that pays bridge calls and transfers. Empty: the wallet behind MIDNIGHT_FEE_SEED_HEX pays them.
NIGHTGATE_API_URL=
# Only with NIGHTGATE_API_URL set: the gateway's access key.
ODATANO_ACCESS_KEY=
# true: the gateway also pays the board's calls and payouts. It then sees them. Needs NIGHTGATE_API_URL.
NIGHTGATE_BOARD_FEES=
# On a self-hosted NIGHTGATE: its agent grant token, with ODATANO_ACCESS_KEY left empty.
NIGHTGATE_AGENT_TOKEN=

# Scripts
# 1 prints a failure with its stack. Without it a script ends with one line.
# LIGHTSOUT_TRACE=
# The agent an MCP server or a script without --as acts for: one of this file, by its name.
# LIGHTSOUT_AGENT=alice
# Or an agent that is not in this file, as these four.
# LIGHTSOUT_NAME=
# LIGHTSOUT_NEAR_ACCOUNT_ID=
# LIGHTSOUT_NEAR_PRIVATE_KEY=
# LIGHTSOUT_SEED_HEX=
# The folder its wallet state lies in, by default kit/.wallet, or ~/.lightsout for the package from npm.
# LIGHTSOUT_STATE_DIR=
# Seconds an agent leaves the bridge's NEAR head to a relay before it follows NEAR itself, by
# default 600. 0 follows at once, for a deployment that runs no relay.
# LIGHTSOUT_RELAY_WAIT_SECONDS=

# Relay (`npm run relay`)
# Optional: where it reads Mithril certificates and Cardano transactions, by default the
# public services of Cardano preview.
# MITHRIL_AGGREGATOR_URL=
# KOIOS_URL=

# Solver (`npm run solve`)
# The smallest reward in wNEAR it works for, by default 0.01. The sandbox page refuses a smaller one.
# LIGHTSOUT_MIN_REWARD=

# A crowd (npm run crowd in mcp/): agents of your own that ask, send, withdraw and deposit in turns.
# Their names, as above. None of them is handed out by the page or answers bounties.
# LIGHTSOUT_CROWD=grace,heidi
# Seconds between two actions, by default 600. NEAR AI models their questions go to, by default the kit's.
# CROWD_ROUND_SECONDS=
# CROWD_MODELS=
# With a key or an auth token Claude calls each agent's MCP tools; without one fixed rules do.
# CROWD_MIND (claude or rules) says it outright, also to the page, which tells visitors who steers.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# CROWD_MIND=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# Decisions per agent and day that Claude makes, by default 200. After that the rules decide.
# CLAUDE_BUDGET=
# The solver pays what it holds above LIGHTSOUT_KEEP (by default 0.5 wNEAR) out to these NEAR accounts in turn.
# LIGHTSOUT_PAY_OUT_TO=
# LIGHTSOUT_KEEP=

# Sandbox page (web/)
# The agents it hands out, by their names above, by default alice. A warm one (`npm run warm`)
# is lent as a ready agent, one that is not registered yet as an agent from zero.
# An agent that answers bounties beside it (`npm run solve -- --as bob`) must not be handed out.
# DEMO_AGENTS=alice
# The account that pays a new agent, which a visitor starts from zero: the name behind
# NEAR_<NAME>_ACCOUNT_ID and NEAR_<NAME>_PRIVATE_KEY. Empty: no new agents. Needs a gateway.
# DEMO_FAUCET=
# The NEAR a new agent gets, by default 2, and the most new agents a day, by default 10.
# DEMO_FAUCET_NEAR=
# DEMO_FAUCET_PER_DAY=
# An agent for a visitor's own machine gets NEAR from the faucet and its gateway key from one
# of these fee codes, comma-separated. At most DEMO_OWN_PER_DAY a day, by default 5.
# DEMO_FEE_CODES=
# DEMO_OWN_PER_DAY=
# The wNEAR one session may move, by default 0.5, and all sessions of a day together, by default 2.
# DEMO_SESSION_BUDGET=
# DEMO_DAY_BUDGET=
# Where it listens, by default 127.0.0.1:8787. Put a TLS proxy in front of it. The proxy of
# deploy/compose.yml forwards to port 8787, so leave DEMO_PORT out there.
# DEMO_HOST=
# DEMO_PORT=
# The page lists the NEAR contract's transactions from the nearblocks index of its network.
# Without a key that index allows few requests from one address.
# Optional: an API key for it, and another instance of that index.
# NEARBLOCKS_API_KEY=
# NEARBLOCKS_API_URL=
# For deploy/compose.yml: the host name its proxy serves the page under and gets a certificate for.
# DEMO_DOMAIN=
# For deploy/compose.yml: a proof server elsewhere, and 0 so that the stack starts none.
# PROOF_SERVER_URL=
# PROOF_SERVERS=
