{
  "name": "lightsout-web",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted sandbox: a visitor gets a LIGHTSOUT agent in the browser and uses it on the live deployment",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --env-file=../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts test/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.17",
    "lightsout-kit": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "near-api-js": "7.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
